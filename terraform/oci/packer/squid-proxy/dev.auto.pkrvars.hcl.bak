# Copy to dev.auto.pkrvars.hcl (gitignored) and fill in real values, or pass
# equivalent -var flags on the command line.
#
# The three values with no defaults are all tenancy-specific:
#   compartment_ocid    `oci iam compartment list`
#   availability_domain `oci iam availability-domain list` - the "Niou:" style
#                       prefix is per-tenancy, not per-region
#   subnet_ocid         run ../build-network/create.sh and use what it prints

compartment_ocid = "ocid1.compartment.oc1..aaaaaaaapeke7pwgbp6xviauvm7b6sxkcbqjl6osm555fxibwetdql7aohjq"
availability_domain = "Niou:AP-MUMBAI-1-AD-1"
subnet_ocid         = "ocid1.subnet.oc1.ap-mumbai-1.REPLACE"

region      = "ap-mumbai-1"
environment = "dev"

# Profile in ~/.oci/config. `access_cfg_file_account` is the builder's name for
# it - not `config_file_profile` (Terraform) and not `profile` (the CLI).
access_cfg_file_account = "devuser"

# Must match the squid-proxy unit's squid_port input and the NLB listener port.
squid_port = 3128
