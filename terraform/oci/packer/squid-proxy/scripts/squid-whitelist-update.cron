# Periodic allowlist refresh - matches the AWS AMI's userdata.sh cron
# (*/15 * * * * root /etc/squid/update_whitelist.sh) and the GCP image's
# /etc/cron.d/squid-whitelist-update. Baked into the image by Packer -
# editing this on a running instance will not survive an image rebuild or an
# instance replacement; change the allowlist OBJECT instead (edit
# whitelisted-domains/<file> in hyperswitch-infra and re-apply the
# squid-proxy unit), which is the whole point of the 15-minute cycle.
*/15 * * * * root /usr/local/bin/update-squid-whitelist.sh >> /var/log/squid/whitelist-update.log 2>&1
