terraform {
  required_version = ">= 1.5.0"

  required_providers {
    oci = {
      source  = "oracle/oci"
      version = "~> 9.0"
    }
  }
}

# hashicorp/tls and hashicorp/random are ABSENT, and that is a deliberate
# security decision. The AWS locker writes an RSA-4096 private key into
# Terraform state in plaintext; this port does not reproduce that. OCI Vault
# generates secrets server-side instead, so no credential material ever exists
# as a Terraform value. An SSH key, if ever needed, is generated by OCI Vault's
# server (generation_type = "SSH_KEY") - stronger than tls_private_key or even
# ephemeral tls_private_key, which still transits the Terraform process.
