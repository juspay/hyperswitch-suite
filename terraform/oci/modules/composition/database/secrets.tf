# =============================================================================
# Admin password in OCI Vault (check sheet feature 12, PARTIAL - section 4.10)
# =============================================================================
# The direct descendant of gcp/modules/composition/alloydb/secretmanager.tf,
# which exists for the identical reason: AlloyDB has no
# manage_master_user_password either, so the module generates a password and
# stores it.
#
# What is NOT reproduced: AWS's manage_master_user_password has RDS create the
# secret, own it and ROTATE it. OCI's credentials.password_details with
# password_type = VAULT_SECRET only reads a secret_id + secret_version the
# caller already created. There is no service-managed rotation and no
# master_user_secret output counterpart.
#
# Nothing here is ever a literal password. The value is either generated by
# random_password.admin or handed in by the caller from its own secret store.
# Accepted consequence, same as on GCP: the generated value is in Terraform
# state, which makes the state backend's encryption load-bearing.
#
# Skipped entirely for a warm standby - it inherits the primary's users and
# cannot own any of its own.

resource "oci_vault_secret" "admin_password" {
  count = local.vault_secret_create ? 1 : 0

  compartment_id = var.compartment_id
  vault_id       = var.vault_secret.vault_id

  # Required by oci_vault_secret. Note the irony worth recording: OCI Vault
  # takes a customer-managed key for the CREDENTIAL, while the database's data
  # at rest cannot (see the CMEK note in outputs.tf and section 4.9). Using a
  # customer-managed key here is the only part of the key-custody story this
  # module can actually tell.
  key_id = var.vault_secret.key_id

  secret_name = local.vault_secret_name
  description = "Admin password for ${local.display_name}"

  secret_content {
    content_type = "BASE64"
    content      = base64encode(local.admin_password)
  }

  freeform_tags = local.freeform_tags
  defined_tags  = var.defined_tags
}
